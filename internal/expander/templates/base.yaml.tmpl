{{/*
Conduit V0 base template: minimal OTel Collector configuration produced from
a validated *config.AgentConfig. See internal/expander/expander.go for the
caller and internal/config/types.go for the input shape.

The output of this template is fed verbatim into the embedded upstream OTel
Collector. Anything written here must be valid for the pinned upstream
version in builder-config.yaml. When you add a profile, do it as a fragment
under internal/profiles/<goos>/ and let the expander splice it via
.ExtraReceivers — keep this file the irreducible core that Conduit always
sets.
*/ -}}
# Generated by conduit. Do not edit by hand; edit conduit.yaml or
# internal/expander/templates/base.yaml.tmpl instead.
receivers:
  otlp:
    protocols:
      grpc:
        endpoint: {{ .OTLPBindAddress }}:4317
      http:
        endpoint: {{ .OTLPBindAddress }}:4318
{{- with .ExtraReceivers }}
{{ . -}}
{{- end }}
{{- if .OBIEnabled }}
  # OBI (OpenTelemetry eBPF Instrumentation) — zero-code application
  # instrumentation. Auto-discovers processes on the host / node and
  # emits HTTP / gRPC / database RED metrics + distributed traces
  # without any code changes in the instrumented services.
  #
  # Every signal OBI emits is scope-tagged instrumentation.scope =
  # "obi" so operators can filter at query time when both OBI and
  # the M8 span_metrics connector are running (the V0.1 default —
  # set obi.replace_span_metrics_connector: true to suppress the
  # connector entirely).
  #
  # The curated schema in conduit.yaml is intentionally minimal
  # (enabled + replace_span_metrics_connector). Tune anything else
  # — instrument targets, OBI feature flags, discovery poll
  # interval, k8s metadata extraction details — through
  # overrides.receivers.obi.<...>; the embedded collector
  # deep-merges overrides over the block emitted here. See
  # docs/adr/adr-0020.md.
  obi:
    meter_provider:
      # application: HTTP / gRPC / DB RED metrics + traces.
      # Network features (per-connection metrics) are off by
      # default because they're cardinality-explosive on busy
      # hosts; operators who want them add `network` via
      # overrides:.
      features: [application]
    # discovery.instrument is the modern selector form (Globs); it
    # supersedes the deprecated `services:` (Regex) form. At least
    # one entry is required to enable FeatureAppO11y — without it
    # OBI rejects the config at startup ("at least one of 'network',
    # 'application' or 'stats' features must be enabled"). The
    # `meter_provider.features: [application]` line above is a
    # downstream metric-export filter, NOT the on-switch for the
    # feature itself; that distinction surprises every operator
    # the first time, including us.
    #
    # open_ports: 1-65535 matches every TCP-listening process on
    # the host / node, which is what zero-code instrumentation
    # should do by default. OBI's default_exclude_instrument list
    # automatically skips OBI itself, Prometheus, Jaeger, and the
    # other usual observability daemons, so this won't loop on
    # the conduit agent. Operators who want narrower scoping use
    # overrides.receivers.obi.discovery.instrument: [...] to
    # replace this with explicit selectors (per-service name,
    # exe_path glob, namespace, etc.) — see ADR-0020 sub-decision 5
    # and the "Filtering sensitive data" / "Tail-based sampling"
    # sections of the OBI Collector-receiver upstream docs.
    discovery:
      instrument:
        - open_ports: 1-65535
{{- if .OBIJavaTLS }}
    # OBI ships an embedded Java instrumentation agent
    # (pkg/internal/java/embedded/obi-java-agent.jar in upstream,
    # baked into the conduit binary via go:embed). When enabled, the
    # discovery loop dynamic-attaches it to running JVMs through the
    # HotSpot Attach API. Two effects: (1) HTTP/gRPC headers + bodies
    # become visible on TLS-internal calls (without it OBI sees
    # encrypted bytes only); (2) the W3C traceparent header gets
    # injected on outbound calls so downstream services pick up the
    # parent span — closing the propagation gap that pure-eBPF
    # context-propagation has on Java's TLS write path.
    #
    # Cost: SYS_PTRACE on the target JVM (already required for OBI's
    # process discovery) plus per-JVM bytecode injection overhead at
    # attach time. Operators flip this on for TLS-internal Java
    # fleets (mTLS service mesh, cluster-internal HTTPS); leave it
    # off for plaintext-only or non-Java workloads.
    javaagent:
      enabled: true
{{- end }}
{{- if .OBINodeJS }}
    # OBI's NodeJS instrumentation injector. Without it the OBI
    # generic tracer logs "trace-context propagation will not work
    # for NodeJS services!" and each Node hop emits a span without
    # parent linkage to the upstream caller. Enable for Node fleets
    # where you want trace continuity through HTTP / gRPC client
    # calls. Off by default; ADR-0020 sub-decision 5 governs the
    # curated-surface promotion rationale.
    nodejs:
      enabled: true
{{- end }}
{{- if .OBIK8sMetadata }}
    # On the k8s profile, OBI auto-tags spans / metrics with the
    # workload's namespace, pod name, deployment, and node — the
    # same set k8sattributes layers on for OTLP traffic. Off on
    # every other profile because k8s API access is not
    # available there.
    attributes:
      kubernetes:
        # Quoted because OBI's kubeflags.EnableFlag is a string-typed field
        # with `validate:"oneof=true false autodetect"` (see
        # third_party/obi/pkg/transform/k8s.go in the local checkout). An
        # unquoted YAML true unmarshals as a Go bool and trips the validator
        # at collector startup with "Field validation for 'Enable' failed
        # on the 'oneof' tag." "autodetect" would also work; we emit "true"
        # because we only render this block when we already know we're on
        # the k8s profile (OBIK8sMetadata gate above).
        enable: "true"
{{- end }}
{{- end }}
{{- if .K8sCluster }}
  # k8s_cluster emits cluster-state metrics (deployment / replica
  # counts, pod phase, node conditions, resource quotas) by watching
  # the Kubernetes API. Rendered only for profile.mode=k8s-cluster,
  # which the Helm chart deploys as a SINGLE replica so this
  # cluster-scoped data is collected once, not once per node. The
  # read-only RBAC it needs lives in the chart's ClusterRole.
  k8s_cluster:
    auth_type: serviceAccount
    collection_interval: 30s
    node_conditions_to_report: [Ready, MemoryPressure, DiskPressure, PIDPressure, NetworkUnavailable]
    allocatable_types_to_report: [cpu, memory, ephemeral-storage, pods]
{{- end }}
{{- if .K8sObjects }}
  # k8sobjects watches the Kubernetes Events API and emits each event
  # as a log record (k8s.object.* attributes), so cluster activity —
  # scheduling decisions, image pulls, OOMKills, probe failures —
  # lands in the logs pipeline. Pairs with k8s_cluster on the
  # cluster-singleton collector (profile.mode=k8s-cluster).
  k8sobjects:
    auth_type: serviceAccount
    objects:
      - name: events
        mode: watch
        group: events.k8s.io
{{- end }}
{{- if .PrometheusEnabled }}
  # prometheus scrapes operator-declared /metrics endpoints
  # (metrics.prometheus.scrape_configs). This is the curated surface
  # over the upstream prometheusreceiver — it unlocks the whole
  # Prometheus exporter ecosystem (node_exporter, kube-state-metrics,
  # app /metrics, redis_exporter, nginx-prometheus-exporter, …)
  # without a per-source receiver. Advanced scrape config
  # (relabel_configs, basic_auth, tls_config, *_sd_configs) is reached
  # through overrides.receivers.prometheus.config.<...> per ADR-0012.
  prometheus:
    config:
      scrape_configs:
{{- range .PrometheusJobs }}
        - job_name: {{ .JobName | q }}
          scrape_interval: {{ .ScrapeInterval }}
          metrics_path: {{ .MetricsPath | q }}
          scheme: {{ .Scheme }}
          static_configs:
            - targets:
{{- range .Targets }}
                - {{ . | q }}
{{- end }}
{{- end }}
{{- end }}

processors:
  memory_limiter:
    check_interval: 1s
    limit_percentage: 80
    spike_limit_percentage: 25
  # resourcedetection populates host identity (host.name, host.id,
  # host.arch, os.type, os.description, ...) on every emitted signal so
  # multi-host deployments can break down telemetry by host. Always on;
  # not gated by profile since host identity is universal.
  #
  # Detector order matters: with override=false the first detector to set
  # a key wins. [env, system] means OTEL_RESOURCE_ATTRIBUTES (e.g.
  # host.name=node-foo from a Kubernetes downward-API env var) takes
  # precedence over the OS-detected hostname, while system fills in
  # everything env didn't supply. Both detectors leave incoming OTLP
  # resource attributes from upstream apps untouched.
  resourcedetection:
    detectors: [env, system]
    timeout: 2s
    override: false
  batch:
    send_batch_size: 8192
    timeout: 200ms
  resource:
    # service.name uses action: insert so the agent's profile-shaped default
    # (linux-host, macos-host, k8s-cluster, etc — see ADR-0021) labels signals
    # Conduit emits or discovers itself (host metrics, host logs, journald)
    # WITHOUT clobbering the service.name an upstream application sent on its
    # OTLP traffic. deployment.environment keeps action: upsert because env
    # tagging is a deployment concern that the operator deliberately wants to
    # win over whatever the application emitted.
    attributes:
      - key: service.name
        value: {{ .ServiceName | q }}
        action: insert
      - key: deployment.environment
        value: {{ .DeploymentEnvironment | q }}
        action: upsert
{{- if .K8sAttributes }}
  # k8sattributes enriches every signal with Kubernetes workload metadata
  # by associating the source pod (via IP, UID, or connection) and copying
  # configured fields onto resource attributes. Runs after resourcedetection
  # (so host identity is already on the record) and before resource (so the
  # user's explicit conduit.yaml service.name / deployment.environment can
  # still override what was discovered).
  #
  # filter.node_from_env_var scopes the watcher to pods on the local node
  # (K8S_NODE_NAME comes from the downward API; the Helm chart's DaemonSet
  # wires it into every Conduit pod). Without this scope every Conduit
  # replica would watch every pod in the cluster, dragging on the API
  # server proportional to fleet size.
  k8sattributes:
    auth_type: serviceAccount
    passthrough: false
    filter:
      node_from_env_var: K8S_NODE_NAME
    extract:
      metadata:
        - k8s.namespace.name
        - k8s.pod.name
        - k8s.pod.uid
        - k8s.pod.start_time
        - k8s.deployment.name
        - k8s.replicaset.name
        - k8s.daemonset.name
        - k8s.statefulset.name
        - k8s.job.name
        - k8s.cronjob.name
        - k8s.node.name
    pod_association:
      - sources:
          - from: resource_attribute
            name: k8s.pod.ip
      - sources:
          - from: resource_attribute
            name: k8s.pod.uid
      - sources:
          - from: connection
{{- end }}
  # transform/logs structures common log formats into one column shape
  # (ADR-0024), in seven independent statement blocks (run in
  # declaration order; each block's conditions filter records
  # independently):
  #
  #   1. (M9.B) Masks well-known secret patterns in body and
  #      attributes["message"] BEFORE any downstream stage (the lift
  #      blocks below, drain templating) can copy them elsewhere.
  #      Default-on per ADR-0006's spirit and
  #      [01-product-requirements.md] §FR-9 — even a Conduit operator who
  #      hasn't read the redaction docs should not accidentally ship
  #      plaintext credentials to Honeycomb / Datadog / Grafana Cloud.
  #      Patterns are intentionally narrow (high-confidence prefix +
  #      length + structure) to avoid false positives that would mask
  #      legitimate hex strings or base64 payloads. Operators who need
  #      stricter masking layer additional rules via overrides:
  #      (ADR-0012); operators who need looser masking are typically
  #      better off fixing their app's logging.
  #
  #   2. (M9.C) Parses JSON-bodied logs (Go zerolog, JS pino, Python
  #      structlog, anything emitting `{"level":"info","msg":"..."}`)
  #      and lifts the well-known fields onto OTel semantic locations:
  #      trace_id / span_id (under three common naming conventions —
  #      OTel-canonical, camelCase, dotted), msg or message into
  #      attributes["message"] so Honeycomb has a clean message column
  #      next to the full JSON body, and severity_text (from level /
  #      severity / log.level). Gated on `IsString(body) and ^\\s*\\{`;
  #      non-JSON bodies skip this block entirely. SDK-set trace ids
  #      and severities are preserved by `trace_id.string == ""` /
  #      `severity_number == UNSPECIFIED` guards.
  #
  #   3. Parses logfmt-bodied logs (Go logrus text format, Heroku-style
  #      key=value emitters) with the same lift targets as the JSON
  #      block. Gated on the body STARTING with a key=value pair AND
  #      containing a level/lvl/severity/msg/message pair, so prose
  #      that merely contains an equals sign never pays the parse.
  #      ParseKeyValue understands quoted values; a line that fails to
  #      parse cleanly errors out of the statement and is skipped via
  #      error_mode: ignore.
  #
  #   4. Maps klog/glog line headers ("E0826 20:24:19.123456 12 f.go:1]
  #      msg" — kube-system components, etcd, and most Kubernetes
  #      ecosystem daemons) onto severity_text via the leading I/W/E/F
  #      marker.
  #
  #   5. Extracts a leading level token from plain-text bodies —
  #      "ERROR: disk full", "[warn] retrying", Python logging's
  #      "WARNING:root:msg" — into severity_text. Anchored at the start
  #      of the body so a message that merely mentions the word "error"
  #      is never re-leveled.
  #
  #   6. Normalizes severity_text into severity_number with one shared
  #      case-insensitive mapping (trace/debug/info/warn/error/fatal
  #      plus common aliases). Runs after every block that can set
  #      severity_text (2-5) so JSON, logfmt, klog, and token-derived
  #      severities all land on the same numeric scale; the
  #      severity_number == UNSPECIFIED guard preserves SDK-set and
  #      receiver-set (journald PRIORITY, Windows event level) values.
  #
  #   7. Defaults severity to INFO when no stage set one, so Honeycomb
  #      severity filters never silently drop unparsed records.
  #
  # error_mode: ignore (rather than the upstream default, propagate)
  # keeps one malformed record from failing its whole batch: a
  # statement that errors — ParseJSON on truncated JSON, ParseKeyValue
  # on an irregular key=value line — logs at debug and moves on,
  # leaving that record unstructured but delivered.
  transform/logs:
    error_mode: ignore
    log_statements:
      - context: log
        conditions:
          - 'IsString(body) or attributes["message"] != nil'
        statements:
          # AWS access key IDs ("AKIA"+16 uppercase alphanumerics) are
          # the most distinctive credential pattern in cloud workloads
          # — the matching 40-char secret access key is too generic
          # for safe regex matching, so masking the access key id is
          # the practical signal that "an AWS credential leaked here".
          - 'replace_pattern(body, "AKIA[0-9A-Z]{16}", "AKIA****REDACTED****") where IsString(body)'
          - 'replace_pattern(attributes["message"], "AKIA[0-9A-Z]{16}", "AKIA****REDACTED****") where attributes["message"] != nil'
          # JSON Web Tokens — three base64url-encoded segments separated
          # by dots, prefixed with the standard "eyJ" header. Distinctive
          # enough to mask without false positives because the prefix
          # plus three-segment structure plus minimum lengths are very
          # unlikely to collide with non-JWT content.
          - 'replace_pattern(body, "eyJ[A-Za-z0-9_=-]{8,}\\.[A-Za-z0-9_=-]{4,}\\.[A-Za-z0-9_=.+/-]{4,}", "eyJ****REDACTED****") where IsString(body)'
          - 'replace_pattern(attributes["message"], "eyJ[A-Za-z0-9_=-]{8,}\\.[A-Za-z0-9_=-]{4,}\\.[A-Za-z0-9_=.+/-]{4,}", "eyJ****REDACTED****") where attributes["message"] != nil'
          # Common credential key=value patterns. Case-insensitive on the
          # key name, terminated by whitespace / comma / semicolon /
          # ampersand / quote so URL-style and form-style encodings both
          # mask cleanly. The value (everything after the =) is replaced
          # with "****REDACTED****"; the key is preserved so operators
          # can still see WHAT was redacted at query time.
          - 'replace_pattern(body, "(?i)(password|passwd|secret|token|apikey|api_key|access_key|aws_secret_access_key|authorization)=[^\\s,&;\"]+", "$1=****REDACTED****") where IsString(body)'
          - 'replace_pattern(attributes["message"], "(?i)(password|passwd|secret|token|apikey|api_key|access_key|aws_secret_access_key|authorization)=[^\\s,&;\"]+", "$1=****REDACTED****") where attributes["message"] != nil'
      - context: log
        # Single AND'd condition (not two list items) so OTTL
        # short-circuits — IsMatch is never invoked on a non-string
        # body. Journald (and any other receiver that emits structured
        # bodies as pcommon.Map) hit this path; calling IsMatch on a
        # Map errors in OTTL rather than returning false, and the
        # transform processor in contrib v0.152.0 can let a block
        # execute through that error. The per-statement `where
        # IsString(body)` guard below is the second line of defense.
        conditions:
          - 'IsString(body) and IsMatch(body, "^\\s*\\{")'
        statements:
          # Parse once into the per-record cache so subsequent
          # statements can index without re-parsing. ParseJSON errors
          # are non-fatal in OTTL — malformed JSON leaves cache["json"]
          # unset and every gated statement below skips via its
          # cache["json"] != nil short-circuit. The explicit
          # `where IsString(body)` here defends against the same
          # OTTL block-conditions edge case described above.
          - 'set(cache["json"], ParseJSON(body)) where IsString(body)'
          # Trace / span id lift: three naming conventions are common
          # in the wild (OTel-canonical trace_id, camelCase traceId,
          # dotted trace.id). First match wins; the all-zeros guards
          # preserve any value an upstream OTLP stage already set (so a
          # correctly-correlating SDK isn't overwritten by the agent).
          # NB: an unset pdata trace/span id reads back through OTTL's
          # .string accessor as the zero-hex string, NOT "" — comparing
          # against "" silently disables the lift.
          - 'set(trace_id.string, cache["json"]["trace_id"]) where cache["json"] != nil and IsString(cache["json"]["trace_id"]) and trace_id.string == "00000000000000000000000000000000"'
          - 'set(trace_id.string, cache["json"]["traceId"]) where cache["json"] != nil and IsString(cache["json"]["traceId"]) and trace_id.string == "00000000000000000000000000000000"'
          - 'set(trace_id.string, cache["json"]["trace.id"]) where cache["json"] != nil and IsString(cache["json"]["trace.id"]) and trace_id.string == "00000000000000000000000000000000"'
          - 'set(span_id.string, cache["json"]["span_id"]) where cache["json"] != nil and IsString(cache["json"]["span_id"]) and span_id.string == "0000000000000000"'
          - 'set(span_id.string, cache["json"]["spanId"]) where cache["json"] != nil and IsString(cache["json"]["spanId"]) and span_id.string == "0000000000000000"'
          - 'set(span_id.string, cache["json"]["span.id"]) where cache["json"] != nil and IsString(cache["json"]["span.id"]) and span_id.string == "0000000000000000"'
          # Lift JSON's msg / message into attributes["message"] so
          # Honeycomb gets a clean message column next to the full
          # JSON body. attributes["message"] == nil guard keeps any
          # value an upstream stage already set.
          - 'set(attributes["message"], cache["json"]["msg"]) where cache["json"] != nil and IsString(cache["json"]["msg"]) and attributes["message"] == nil'
          - 'set(attributes["message"], cache["json"]["message"]) where cache["json"] != nil and IsString(cache["json"]["message"]) and attributes["message"] == nil'
          # Severity text lift under the three common JSON key names.
          # The shared text→number mapping block (block 6 below)
          # normalizes whatever lands here. Gated on severity_number ==
          # UNSPECIFIED so SDK-set severities pass through untouched.
          - 'set(severity_text, cache["json"]["level"]) where cache["json"] != nil and IsString(cache["json"]["level"]) and severity_number == SEVERITY_NUMBER_UNSPECIFIED'
          - 'set(severity_text, cache["json"]["severity"]) where cache["json"] != nil and IsString(cache["json"]["severity"]) and severity_number == SEVERITY_NUMBER_UNSPECIFIED'
          - 'set(severity_text, cache["json"]["log.level"]) where cache["json"] != nil and IsString(cache["json"]["log.level"]) and severity_number == SEVERITY_NUMBER_UNSPECIFIED'
      - context: log
        # logfmt lift (block 3). Same targets as the JSON block for
        # key=value-bodied logs. The two IsMatch guards keep this off
        # prose bodies: the line must START with a bare key=value pair
        # and carry at least one of the level/message keys we lift.
        conditions:
          - 'IsString(body) and IsMatch(body, "^[A-Za-z_][A-Za-z0-9_.]*=") and IsMatch(body, "(^|\\s)(level|lvl|severity|msg|message)=")'
        statements:
          - 'set(cache["kv"], ParseKeyValue(body)) where IsString(body)'
          - 'set(trace_id.string, cache["kv"]["trace_id"]) where cache["kv"] != nil and IsString(cache["kv"]["trace_id"]) and trace_id.string == "00000000000000000000000000000000"'
          - 'set(span_id.string, cache["kv"]["span_id"]) where cache["kv"] != nil and IsString(cache["kv"]["span_id"]) and span_id.string == "0000000000000000"'
          - 'set(attributes["message"], cache["kv"]["msg"]) where cache["kv"] != nil and IsString(cache["kv"]["msg"]) and attributes["message"] == nil'
          - 'set(attributes["message"], cache["kv"]["message"]) where cache["kv"] != nil and IsString(cache["kv"]["message"]) and attributes["message"] == nil'
          - 'set(severity_text, cache["kv"]["level"]) where cache["kv"] != nil and IsString(cache["kv"]["level"]) and severity_number == SEVERITY_NUMBER_UNSPECIFIED'
          - 'set(severity_text, cache["kv"]["lvl"]) where cache["kv"] != nil and IsString(cache["kv"]["lvl"]) and severity_number == SEVERITY_NUMBER_UNSPECIFIED'
          - 'set(severity_text, cache["kv"]["severity"]) where cache["kv"] != nil and IsString(cache["kv"]["severity"]) and severity_number == SEVERITY_NUMBER_UNSPECIFIED'
      - context: log
        # klog/glog severity (block 4): the single-letter marker that
        # opens every klog line header is the severity.
        conditions:
          - 'IsString(body) and IsMatch(body, "^[IWEF][0-9]{4} [0-9]{2}:[0-9]{2}:[0-9]{2}") and severity_number == SEVERITY_NUMBER_UNSPECIFIED'
        statements:
          - 'set(severity_text, "INFO") where IsMatch(body, "^I")'
          - 'set(severity_text, "WARN") where IsMatch(body, "^W")'
          - 'set(severity_text, "ERROR") where IsMatch(body, "^E")'
          - 'set(severity_text, "FATAL") where IsMatch(body, "^F")'
      - context: log
        # Leading level token (block 5): "ERROR: disk full",
        # "[warn] retrying", "WARNING:root:msg". Anchored to the start
        # of the body — a message that merely mentions "error" mid-
        # sentence is never re-leveled.
        conditions:
          - 'IsString(body) and severity_number == SEVERITY_NUMBER_UNSPECIFIED and severity_text == ""'
        statements:
          - 'set(severity_text, "TRACE") where IsMatch(body, "(?i)^\\s*\\[?trace[\\]:\\s]")'
          - 'set(severity_text, "DEBUG") where severity_text == "" and IsMatch(body, "(?i)^\\s*\\[?debug[\\]:\\s]")'
          - 'set(severity_text, "INFO") where severity_text == "" and IsMatch(body, "(?i)^\\s*\\[?info[\\]:\\s]")'
          - 'set(severity_text, "WARN") where severity_text == "" and IsMatch(body, "(?i)^\\s*\\[?warn(ing)?[\\]:\\s]")'
          - 'set(severity_text, "ERROR") where severity_text == "" and IsMatch(body, "(?i)^\\s*\\[?err(or)?[\\]:\\s]")'
          - 'set(severity_text, "FATAL") where severity_text == "" and IsMatch(body, "(?i)^\\s*\\[?(fatal|critical|panic)[\\]:\\s]")'
      - context: log
        # Shared severity_text → severity_number normalization
        # (block 6). One mapping for every lift path above; the
        # UNSPECIFIED guard preserves numbers set by SDKs, journald
        # PRIORITY parsing, and the Windows event level.
        conditions:
          - 'severity_number == SEVERITY_NUMBER_UNSPECIFIED and severity_text != ""'
        statements:
          - 'set(severity_number, SEVERITY_NUMBER_TRACE) where IsMatch(severity_text, "(?i)^trace$")'
          - 'set(severity_number, SEVERITY_NUMBER_DEBUG) where IsMatch(severity_text, "(?i)^(debug|dbg)$")'
          - 'set(severity_number, SEVERITY_NUMBER_INFO) where IsMatch(severity_text, "(?i)^(info(rmational)?|notice)$")'
          - 'set(severity_number, SEVERITY_NUMBER_WARN) where IsMatch(severity_text, "(?i)^warn(ing)?$")'
          - 'set(severity_number, SEVERITY_NUMBER_ERROR) where IsMatch(severity_text, "(?i)^(error|err|severe)$")'
          - 'set(severity_number, SEVERITY_NUMBER_FATAL) where IsMatch(severity_text, "(?i)^(fatal|critical|crit|panic|emerg(ency)?|alert)$")'
          # Canonicalize the text to the OTel level names so Honeycomb
          # queries see one vocabulary ("WARN"), not each logger's
          # casing ("warn" / "Warning" / "notice"). Scoped to this
          # block's records (severity_number was UNSPECIFIED at block
          # entry) so OTLP-supplied severity text is never rewritten.
          - 'set(severity_text, "TRACE") where severity_number == SEVERITY_NUMBER_TRACE'
          - 'set(severity_text, "DEBUG") where severity_number == SEVERITY_NUMBER_DEBUG'
          - 'set(severity_text, "INFO") where severity_number == SEVERITY_NUMBER_INFO'
          - 'set(severity_text, "WARN") where severity_number == SEVERITY_NUMBER_WARN'
          - 'set(severity_text, "ERROR") where severity_number == SEVERITY_NUMBER_ERROR'
          - 'set(severity_text, "FATAL") where severity_number == SEVERITY_NUMBER_FATAL'
      - context: log
        # Default severity (block 7): INFO for anything no stage above
        # could classify, so Honeycomb severity filters never silently
        # drop unparsed records.
        conditions:
          - 'severity_number == SEVERITY_NUMBER_UNSPECIFIED'
        statements:
          - 'set(severity_text, "INFO")'
          - 'set(severity_number, SEVERITY_NUMBER_INFO)'
  # drain runs the Drain log-clustering algorithm over every record's
  # (post-redaction, post-restructuring) body and annotates each with
  # the cluster's template string as attributes["log.record.template"]
  # ("Deleted <*> messages from <*>"), giving Honeycomb a stable
  # GROUP BY column for "what log shapes are flooding me?" — the
  # adaptive successor to the regex-masked normalized_message column
  # (ADR-0024). Annotation-only: no record is mutated beyond the added
  # attribute, and nothing is sampled or dropped.
  #
  # Runs AFTER transform/logs so templates are learned from redacted
  # bodies — a credential masked by the M9.B block can never be frozen
  # into a template — and after the profile fragments' receivers have
  # replaced syslog envelopes with the bare message, so templates never
  # embed today's date as a literal token.
  #
  # max_clusters bounds tree memory on pathological log diversity
  # (least-recently-used clusters are evicted past the cap). "=" as an
  # extra token delimiter keeps key names literal in templates for
  # key=value content ("level <*>" instead of a fully-wildcarded
  # token). The upstream defaults (tree_depth 4, merge_threshold 0.4,
  # max_node_children 100) are the Drain-paper values and deliberately
  # not restated here; tune via overrides.processors.drain per
  # ADR-0012. The processor is alpha upstream — its knobs may shift
  # across Conduit minors (pinned per ADR-0014).
  drain:
    max_clusters: 1024
    extra_delimiters: ["="]
{{- if .DrainBodyField }}
    # On this platform the default log receiver emits structured map
    # bodies; template the human-readable message field instead of the
    # map's string rendering.
    body_field: {{ .DrainBodyField | q }}
{{- end }}
{{- if .REDEnabled }}
  # filter/red_requests scopes RED derivation to request-like spans.
  # Without it the span_metrics connector would emit a request count
  # for EVERY span — including client, internal, and producer spans
  # that do not represent an inbound application request — inflating
  # rate / error figures with work that isn't a serviced request.
  #
  # This processor runs ONLY in the dedicated traces/red pipeline
  # (see service.pipelines below), so the main traces pipeline still
  # ships every span to Honeycomb unchanged — RED derivation never
  # reduces or mutates the original trace/event stream (ADR-0022,
  # building on ADR-0006). A span is kept when its kind is Server or
  # Consumer (the OTel notion of a request-receiving operation) and
  # dropped otherwise. error_mode: ignore keeps a span if a condition
  # ever errors rather than failing the whole batch.
  filter/red_requests:
    error_mode: ignore
    traces:
      span:
        - 'kind != SPAN_KIND_SERVER and kind != SPAN_KIND_CONSUMER'
{{- end }}

exporters:
{{- if eq .Output.Mode "honeycomb" }}
  otlphttp/honeycomb:
    endpoint: {{ .Output.Honeycomb.Endpoint | q }}
    headers:
      x-honeycomb-team: {{ .Output.Honeycomb.APIKey | q }}
    compression: gzip
{{- if .PersistentQueueEnabled }}
    sending_queue:
      enabled: true
      storage: file_storage
{{- end }}
{{- if .RefineryEnabled }}
  # M10.B: traces flow through this exporter instead of going direct
  # to Honeycomb. Refinery applies tail-based sampling rules and
  # forwards kept traces to Honeycomb on the same API key. Metrics +
  # logs continue through otlphttp/honeycomb above.
  otlp/refinery:
    endpoint: {{ .RefineryEndpoint | q }}
    headers:
      x-honeycomb-team: {{ .Output.Honeycomb.APIKey | q }}
    tls:
      insecure: {{ .RefineryInsecure }}
{{- if .PersistentQueueEnabled }}
    sending_queue:
      enabled: true
      storage: file_storage
{{- end }}
{{- end }}
{{- else if eq .Output.Mode "otlp" }}
  otlphttp/otlp:
    endpoint: {{ .Output.OTLP.Endpoint | q }}
{{- if .Output.OTLP.Headers }}
    headers:
{{- range $k, $v := .Output.OTLP.Headers }}
      {{ $k }}: {{ $v | q }}
{{- end }}
{{- end }}
    compression: {{ if .Output.OTLP.Compression }}{{ .Output.OTLP.Compression | q }}{{ else }}gzip{{ end }}
{{- if .Output.OTLP.Insecure }}
    tls:
      insecure: true
{{- end }}
{{- if .PersistentQueueEnabled }}
    sending_queue:
      enabled: true
      storage: file_storage
{{- end }}
{{- else if eq .Output.Mode "gateway" }}
  otlp/gateway:
    endpoint: {{ .Output.Gateway.Endpoint | q }}
{{- if .Output.Gateway.Headers }}
    headers:
{{- range $k, $v := .Output.Gateway.Headers }}
      {{ $k }}: {{ $v | q }}
{{- end }}
{{- end }}
    # M10.C: TLS is required by default for gateway egress (AC-06.3).
    # `insecure: false` is rendered explicitly so `conduit preview`
    # makes the contract visible; `insecure: true` is the lab-only
    # opt-in that conduit doctor (M11) flags as a warning even when
    # the connection succeeds.
    tls:
      insecure: {{ .GatewayInsecure }}
{{- if .PersistentQueueEnabled }}
    sending_queue:
      enabled: true
      storage: file_storage
{{- end }}
{{- end }}
  debug:
    verbosity: basic
{{- if .REDEnabled }}

# span_metrics derives a RED metrics stream (request count / error
# count via the built-in status.code dimension / duration histogram)
# from the dedicated traces/red pipeline and lands it on the metrics
# pipeline before any sampling step. It only ever sees request-like
# spans because traces/red applies filter/red_requests upstream of it.
# The dimension list below is the documented Conduit default plus any
# user-supplied additions in metrics.red.span_dimensions /
# metrics.red.extra_resource_dimensions; ADR-0006 documents the
# allowlist + denylist model, ADR-0022 the request-span scoping, and
# conduit doctor (M11) surfaces CDT0501 / CDT0510 when those guardrails
# fire.
#
# aggregation_cardinality_limit caps total tracked dimension
# combinations; excess flows to a single overflow series tagged
# otel.metric.overflow="true" so cardinality-blowup is visible at
# query time instead of crashing the agent.
connectors:
  span_metrics:
    histogram:
      explicit:
        buckets: [{{ join .REDHistogramBuckets ", " }}]
    dimensions:
{{- range .REDSpanDimensions }}
      - name: {{ . }}
{{- end }}
    resource_metrics_key_attributes:
{{- range .REDResourceDimensions }}
      - {{ . }}
{{- end }}
    add_resource_attributes: true
    aggregation_cardinality_limit: {{ .REDCardinalityLimit }}
    metrics_flush_interval: 60s
{{- end }}

# health_check is always on so Docker HEALTHCHECK, k8s liveness/readiness
# probes, and `conduit doctor` (M11) all have a single, vendor-neutral
# endpoint to hit. Bound to 0.0.0.0 on every profile because the endpoint
# only reports collector liveness — there is no telemetry payload to
# protect, and host-mode operators can still reach it via 127.0.0.1.
#
# file_storage (M10.A) is rendered only when output.persistent_queue
# is enabled. It backs every active exporter's sending_queue with disk
# so OTLP batches survive restarts and crashes; on_start compaction
# reclaims tombstoned space from previous runs.
extensions:
  health_check:
    endpoint: 0.0.0.0:13133
{{- if .PersistentQueueEnabled }}
  file_storage:
    directory: {{ .PersistentQueueDir | q }}
    timeout: 1s
    compaction:
      directory: {{ .PersistentQueueDir | q }}
      on_start: true
{{- end }}

service:
  extensions: [health_check{{ if .PersistentQueueEnabled }}, file_storage{{ end }}]
  pipelines:
    traces:
      receivers:
{{- range .TraceReceivers }}
        - {{ . }}
{{- end }}
      processors: [{{ join .TraceProcessors ", " }}]
      exporters: [{{ join .TraceExporters ", " }}]
{{- if .REDEnabled }}
    # traces/red is the RED-derivation pipeline. It shares the otlp
    # (and obi, when enabled) receiver with the main traces pipeline
    # above — the receiver fans the same span stream out to both — so
    # RED metrics are derived from 100% of spans BEFORE any downstream
    # trace sampler (e.g. Refinery) sees them (ADR-0005). It runs the
    # same resource-shaping processors as the main pipeline so the
    # connector's resource_metrics_key_attributes resolve, plus
    # filter/red_requests to keep only request-like spans, then feeds
    # the span_metrics connector as its only exporter. The connector
    # surfaces the derived metrics on the metrics pipeline below.
    traces/red:
      receivers:
{{- range .TraceReceivers }}
        - {{ . }}
{{- end }}
      processors: [{{ join .REDTraceProcessors ", " }}]
      exporters: [span_metrics]
{{- end }}
    metrics:
      receivers:
{{- range .MetricReceivers }}
        - {{ . }}
{{- end }}
      processors: [{{ join .MetricProcessors ", " }}]
      exporters: [{{ join .MetricExporters ", " }}]
    logs:
      receivers:
{{- range .LogReceivers }}
        - {{ . }}
{{- end }}
      processors: [{{ join .LogProcessors ", " }}]
      exporters: [{{ join .LogExporters ", " }}]
